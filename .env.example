# 复制这个文件为 .env，然后填入你自己的值。
#   copy .env.example .env
#
# .env 已经被 .gitignore 忽略，**绝不会进仓库**。
# 真实 Key 不要写进源码、测试、前端或任何提交。

# ------------------------------------------------------------------
# 用哪个 Provider
#   mock     —— 默认。完全本地、确定性、不花钱、不联网
#   deepseek —— 真实 API。必须显式设置才会启用
# 注意：装上 Key 并不会自动切换，必须同时设置 AI_PROVIDER=deepseek。
# ------------------------------------------------------------------
AI_PROVIDER=mock

# ------------------------------------------------------------------
# DeepSeek（只有 AI_PROVIDER=deepseek 时才会用到）
# 到 https://platform.deepseek.com 申请，形如 sk-xxxxxxxx
# ------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次请求超时（秒）。本版本一次回合只发一次请求，失败就直接返回，不重试。
DEEPSEEK_TIMEOUT=30

# 成本控制：限制输出长度。输出越长越贵。
DEEPSEEK_MAX_TOKENS=800

# 结构化 JSON 输出需要稳定，不要调太高
DEEPSEEK_TEMPERATURE=0.7
